DATABASE_URL="postgresql://postgres:password@localhost:5432/linkedin-scraper?schema=public"
APP_URL=http://localhost:3000
AUTH_URL=${APP_URL}
NEXTAUTH_URL=${APP_URL}
AUTH_SECRET=super-secret-key-for-authentication
AUTH_TRUST_HOST=true

# AES-256-GCM master key for sealing LinkedIn passwords, storageState, and proxy
# credentials — 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must NOT equal AUTH_SECRET, and must not be derived from a password.
ENCRYPTION_KEY=

# LinkedIn accounts are added and managed entirely from /config/accounts — no env vars
# for them; there is no bootstrap-from-.env path (ARCHITECTURE.md §10).

# Bootstrap-only: db:seed creates the first ADMIN User (bcrypt-hashed) if none exists yet.
# Every other user is created from the dashboard's /users page by an existing admin — not
# read from application code after the first admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Proxy (ARCHITECTURE.md §10) — USE_PROXY=true with no resolvable proxy fails the job,
# it never falls back to the direct IP.
USE_PROXY=false
PROXY_URL=
PROXY_COUNTRY=

# Worker / scheduler
NODE_ENV=development
WORKER_ID=worker-local-1
WORKER_CONCURRENCY=1
WORKER_QUEUES=default
HEADLESS=true
TZ=UTC
LOG_LEVEL=info

# Queue timing (ARCHITECTURE.md §6)
POLL_INTERVAL_MS=2000
LEASE_SECONDS=900
LEASE_HEARTBEAT_MS=60000
SHUTDOWN_GRACE_MS=30000

# Global pacing fallbacks — only consulted before a per-account ScrapingPolicy row exists.
# db:seed always creates one, so these mirror ScrapingPolicy's own column defaults and are
# exercised in code without drifting from "the DB default" in practice.
SCRAPER_STEP_DELAY_MIN_MS=4000
SCRAPER_STEP_DELAY_MAX_MS=11000
SCRAPER_PROFILE_DELAY_MIN_MS=25000
SCRAPER_PROFILE_DELAY_MAX_MS=90000
SCRAPER_PAGE_DELAY_MIN_MS=45000
SCRAPER_PAGE_DELAY_MAX_MS=150000
MAX_PROFILES_PER_DAY=80
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=18