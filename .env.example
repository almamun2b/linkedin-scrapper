DATABASE_URL="postgresql://postgres:password@localhost:5432/linkedin-scraper?schema=public"
APP_URL=http://localhost:3000
AUTH_URL=${APP_URL}
NEXTAUTH_URL=${APP_URL}
AUTH_SECRET=super-secret-key-for-authentication
AUTH_TRUST_HOST=true

NODE_ENV=development
# AES-256-GCM master key for sealing LinkedIn passwords, storageState, proxy credentials,
# and the ScrapingPolicy fallback-proxy URL — 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must NOT equal AUTH_SECRET, and must not be derived from a password.
ENCRYPTION_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sets the OS process's own timezone before any DB read is possible — the one worker/queue
# setting that could not move to the database for that reason (ARCHITECTURE.md §10,
# docs/configuration.md). Every stored DateTime is timestamptz regardless, so this is a
# convenience for reading raw timestamps in server logs, not a correctness dependency.
TZ=UTC
