{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true,
    },
    "prisma-local": {
      "type": "local",
      "command": [
        "pnpm",
        "exec",
        "prisma",
        "mcp"
      ],
      "enabled": true,
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true,
    },
  },
  "permission": {
    "*": "allow"
  }
}