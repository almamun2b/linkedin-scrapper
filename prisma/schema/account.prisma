// The scraping identity: the LinkedIn account(s) this system logs in as, the proxies assigned to
// them, and per-account pacing/quota policy. See ARCHITECTURE.md §4 and §9 (account safety).

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  COOLING_DOWN
  CHALLENGED
  RESTRICTED
  DISABLED
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS5
}

enum ProxyHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  DEAD
}

model LinkedInAccount {
  id    String @id @default(cuid())
  label String
  email String @unique

  // Sealed secrets: AES-256-GCM, packed iv+tag+ciphertext. Never selected by web-process code —
  // enforced via a client-level `omit` in src/server/db/prisma.ts. keyVer enables key rotation.
  passwordSealed     Bytes
  passwordKeyVer     Int       @default(1)
  storageStateSealed Bytes?
  storageStateKeyVer Int?
  storageStateAt     DateTime? @db.Timestamptz(3)

  // Stable per-account fingerprint (UA, viewport, locale) — generated once, never rotated.
  fingerprint Json
  timezone    String @default("UTC") // IANA id, validated at the application boundary

  proxyId String?
  proxy   Proxy?  @relation(fields: [proxyId], references: [id], onDelete: SetNull)

  status         AccountStatus @default(UNVERIFIED)
  statusReason   String?
  cooldownUntil  DateTime?     @db.Timestamptz(3)
  lastLoginAt    DateTime?     @db.Timestamptz(3)
  lastActivityAt DateTime?     @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  searchDefinitions SearchDefinition[]
  scrapeRuns        ScrapeRun[]
  jobs              Job[]
}

model Proxy {
  id       String        @id @default(cuid())
  label    String
  protocol ProxyProtocol
  host     String
  port     Int
  username String?

  passwordSealed Bytes?
  passwordKeyVer Int?

  country       String?
  sticky        Boolean     @default(true) // one account per proxy, enforced in the assignment service
  active        Boolean     @default(true)
  health        ProxyHealth @default(UNKNOWN)
  failureCount  Int         @default(0)
  lastCheckedAt DateTime?   @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts LinkedInAccount[]
}

// A true global singleton, not a per-account row — this system runs one operator, one
// pacing policy. Pinned with a literal id plus a hand-written `CHECK (id = 'global')` (see
// the migration) so a second row can never be inserted; the same technique the init
// migration already uses for this table's delay-ordering CHECKs. Absorbs the pacing/proxy
// fallback values that used to live in `.env` (ARCHITECTURE.md §10) so an admin can tune
// them from /config/policy without editing a file or restarting a process.
model ScrapingPolicy {
  id String @id @default("global")

  stepDelayMinMs    Int @default(4000)
  stepDelayMaxMs    Int @default(11000)
  profileDelayMinMs Int @default(25000)
  profileDelayMaxMs Int @default(90000)
  pageDelayMinMs    Int @default(45000)
  pageDelayMaxMs    Int @default(150000)

  sessionBreakAfter Int @default(12) // profiles
  sessionBreakMinMs Int @default(600000) // 10 min
  sessionBreakMaxMs Int @default(2700000) // 45 min

  maxProfilesPerDay    Int @default(80)
  maxSearchPagesPerDay Int @default(15)
  maxProfilesPerWeek   Int @default(350)

  activeHoursStart Int     @default(9) // local hour in each LinkedInAccount's own timezone; does not yet express an overnight wrap
  activeHoursEnd   Int     @default(18)
  activeOnWeekends Boolean @default(false)

  useProxy Boolean @default(false)
  headless Boolean @default(true)

  // Fallback proxy (formerly PROXY_URL/PROXY_COUNTRY): consulted only when an account has no
  // Proxy row of its own assigned — never a substitute for per-account assignment. Sealed
  // because a proxy URL commonly carries a username:password (CLAUDE.md invariant #4).
  fallbackProxyUrlSealed Bytes?
  fallbackProxyUrlKeyVer Int?
  proxyCountry           String? // geo hint; not yet consulted by any pool-selection code

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
