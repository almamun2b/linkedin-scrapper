// Audit trail. Every user-visible mutation writes one of these (AGENTS.md Definition of Done).
// entity/entityId are a deliberate polymorphic pair with no FK — by design, not an oversight.

model AuditEvent {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  data     Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId, at])
  @@index([at])
}
