// App-level authentication (NextAuth v5 + @auth/prisma-adapter, wired up in a later stage).
// User is a person who logs into this app — never conflate with LinkedInAccount (account.prisma),
// which is the scraped-from identity.

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(3)
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(VIEWER)
  // Disabling preserves the row (and its AuditEvent.actorId history) instead of deleting it.
  // Checked on every session touch in modules/auth, not just at login.
  disabledAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  accounts          Account[]
  sessions          Session[]
  searchDefinitions SearchDefinition[]
  auditEvents       AuditEvent[]
}

// Field names below match @auth/prisma-adapter's expectations exactly (it reads Prisma field
// names directly) — the one deliberate naming exception to this project's camelCase convention.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}
