// The job queue, implemented entirely on Postgres — no Redis. See ARCHITECTURE.md §6 for the
// claim query (FOR UPDATE SKIP LOCKED), lease/reaper mechanics, and the LISTEN/NOTIFY wakeup.

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum RateMetric {
  PROFILES_PER_DAY
  SEARCH_PAGES_PER_DAY
  PROFILES_PER_WEEK
}

enum JobArtifactKind {
  SCREENSHOT
  HTML
}

model Job {
  id       String    @id @default(cuid())
  queue    String    @default("default")
  type     String // dotted + namespaced, e.g. "profile.scrape" — validated against a zod union, not an enum
  payload  Json
  status   JobStatus @default(QUEUED)
  priority Int       @default(100) // lower runs first
  runAt    DateTime  @default(now()) @db.Timestamptz(3) // visibility / delay

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  lockedBy          String?
  lockedAt          DateTime? @db.Timestamptz(3)
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  cancelRequestedAt DateTime? @db.Timestamptz(3)

  idempotencyKey String? @unique // NULL is distinct per-row in Postgres, so unkeyed jobs never collide

  runId String?
  run   ScrapeRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  linkedInAccountId String?
  linkedInAccount   LinkedInAccount? @relation(fields: [linkedInAccountId], references: [id], onDelete: SetNull)

  lastError  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)

  logs      JobLog[]
  artifacts JobArtifact[]

  // Column order matches the claim query's predicate (queue, status equality) then its
  // ORDER BY (priority, runAt) exactly, so the scan needs no Sort node before LIMIT applies.
  @@index([queue, status, priority, runAt])
  // leaseExpiresAt is not cleared on completion, so it must not be indexed alone — status first
  // keeps the live-lease region the reaper scans small.
  @@index([status, leaseExpiresAt])
  @@index([linkedInAccountId, status])
  @@index([runId])
}

model JobLog {
  id      String   @id @default(cuid())
  jobId   String
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level   LogLevel @default(INFO)
  message String
  data    Json?
  at      DateTime @default(now()) @db.Timestamptz(3)

  @@index([jobId, at])
}

// Evidence captured on a risk signal (checkpoint/authwall/login_redirect/999/captcha) so a
// selector fix can be verified against what the page actually showed, instead of costing
// another login attempt to find out — the same "replay offline" philosophy invariant #7
// applies to `LeadSnapshot`. `bytes` for HTML is gzipped, mirroring `LeadSnapshot.encoding`.
model JobArtifact {
  id          String          @id @default(cuid())
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        JobArtifactKind
  contentType String
  bytes       Bytes
  byteSize    Int
  capturedAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([jobId, capturedAt])
}

// DB-backed token buckets (§9.4). Decrement MUST be one atomic
//   UPDATE "RateBudget" SET consumed = consumed + 1 WHERE ... AND consumed < cap RETURNING consumed
// in server/db/raw/ — check-then-increment across workers is a lost-update race against the one
// number that protects the account from being over-used.
model RateBudget {
  id          String     @id @default(cuid())
  scope       String // e.g. "linkedInAccount"
  scopeId     String
  metric      RateMetric
  windowStart DateTime   @db.Timestamptz(3)
  windowEnd   DateTime   @db.Timestamptz(3)
  consumed    Int        @default(0)
  cap         Int // not "limit" — a reserved SQL word

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([scope, scopeId, metric, windowStart])
  @@index([windowEnd])
}

// Global singleton (see `ScrapingPolicy` for the same pattern) for the worker/queue-timing
// values that used to live in `.env` (ARCHITECTURE.md §10). `workerId` is this row's
// *default* identity — a second worker process overrides it with a `--worker-id` CLI flag
// rather than a second row, since `WorkerHeartbeat` below is keyed by that string per
// process. `TZ` has no column here at all: it sets the OS process's own timezone before any
// DB read is possible, so it stays a literal env var (see `docs/configuration.md`).
// `logLevel` mirrors pino's own level names, not `LogLevel` above (`JobLog.level` is a
// message severity, not a minimum threshold — the two enums' value sets genuinely differ,
// so sharing one would be a false simplification).
model SystemSetting {
  id String @id @default("global")

  workerId          String @default("worker-local-1")
  workerConcurrency Int    @default(1)
  workerQueues      String @default("default") // comma-separated queue names
  pollIntervalMs    Int    @default(2000)
  leaseSeconds      Int    @default(900)
  leaseHeartbeatMs  Int    @default(60000)
  shutdownGraceMs   Int    @default(30000)
  logLevel          String @default("info") // fatal|error|warn|info|debug|trace — validated at the boundary
  displayTimezone   String @default("UTC") // IANA id; dashboard rendering + new-account default

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model WorkerHeartbeat {
  id          String    @id // the WORKER_ID string; no @default — the worker owns its identity
  pid         Int
  host        String
  queues      String[]
  concurrency Int
  startedAt   DateTime  @db.Timestamptz(3)
  lastSeenAt  DateTime  @db.Timestamptz(3)
  stoppedAt   DateTime? @db.Timestamptz(3) // distinguishes a graceful drain from a crash
  version     String
}
